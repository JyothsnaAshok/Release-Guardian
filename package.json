{
  "name": "release-guardian",
  "private": true,
  "version": "0.2.0",
  "description": "An agent that decides whether a release is safe to ship — built on TrueForge for the WeMakeDevs Agent Harness hackathon.",
  "type": "module",
  "engines": { "node": ">=22.22.3" },
  "workspaces": ["packages/*"],
  "scripts": {
    "guardian:dev": "npm --workspace packages/guardian-actions run dev",
    "guardian:start": "npm --workspace packages/guardian-actions run start",
    "pagerduty:dev": "npm --workspace packages/pagerduty-mock run dev",
    "pagerduty:start": "npm --workspace packages/pagerduty-mock run start",
    "composio:dev": "npm --workspace packages/composio-bridge run dev",
    "composio:start": "npm --workspace packages/composio-bridge run start",
    "setup:providers": "node --env-file=.env scripts/setup-providers.mjs",
    "agent:apply": "node --env-file=.env scripts/apply-agent.mjs",
    "agent:haiku": "node --env-file=.env scripts/apply-agent.mjs anthropic/claude-haiku-4-5",
    "agent:sonnet": "node --env-file=.env scripts/apply-agent.mjs anthropic/claude-sonnet-4-6",
    "smoke:freeze": "node --env-file=.env scripts/smoke-freeze.mjs",
    "smoke:readiness": "node --env-file=.env scripts/smoke-readiness.mjs",
    "smoke:rollback": "node --env-file=.env scripts/smoke-rollback.mjs",
    "smoke:e2e": "node --env-file=.env scripts/smoke-e2e.mjs",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
