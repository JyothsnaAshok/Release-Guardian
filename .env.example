# TrueForge server (local mode, no auth)
TRUEFORGE_BASE_URL=http://localhost:8790

# guardian-actions MCP server
# Binds to 127.0.0.1 by default — the endpoint is unauthenticated and its tools
# mutate approval/comms state, so keep it loopback-only unless it sits behind an
# authenticating proxy.
GUARDIAN_HOST=127.0.0.1
GUARDIAN_PORT=9100
GUARDIAN_DB_PATH=./data/guardian.sqlite
GUARDIAN_MCP_URL=http://localhost:9100/mcp

# --- Provider setup (scripts/setup-providers.mjs) ---
MODEL_PROVIDER=anthropic
MODEL_API_KEY=
MODEL_NAME=claude-haiku-4-5
MODEL_UPSTREAM_ID=claude-haiku-4-5-20251001
MODEL_CONTEXT_LENGTH=200000
MODEL_MAX_OUTPUT=32000
DAYTONA_API_KEY=
# Sandbox teardown (minutes). Defaults are aggressive to keep Daytona cost down.
DAYTONA_AUTO_STOP_MIN=3
DAYTONA_AUTO_ARCHIVE_MIN=15
DAYTONA_AUTO_DELETE_MIN=120

# Optional extra OpenAI-compatible "custom" provider (Groq / Cerebras / OpenRouter...).
# Can be the agent's primary model, or the §9.1 dual-model second opinion.
# NB free tiers have low TPM caps — this agent's turn is ~30k tokens, so a free
# 8k-TPM tier (Groq default) returns 413. Groq Dev tier (add a card, $0 minimum)
# lifts it. Run GET <base_url>/models for the model ids your key can use.
CUSTOM_PROVIDER_NAME=groq
CUSTOM_BASE_URL=https://api.groq.com/openai/v1
CUSTOM_API_KEY=
CUSTOM_MODEL_NAME=gpt-oss-120b
CUSTOM_MODEL_UPSTREAM_ID=openai/gpt-oss-120b
CUSTOM_MODEL_CONTEXT_LENGTH=131072
CUSTOM_MODEL_MAX_OUTPUT=32768

# Skills are git-backed — registered from this repo, not the local skills/ dir.
SKILLS_REPO_URL=https://github.com/JyothsnaAshok/Release-Guardian
SKILLS_REPO_REF=main

# GitHub connector (real). Fine-grained PAT, read-only: Contents, Actions, Pull
# requests, Commit statuses, Metadata — scoped to the demo repos. Registered as two
# MCP servers because GitHub's remote server splits the actions toolset onto its own
# endpoint.
GITHUB_PAT=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_ACTIONS_MCP_URL=https://api.githubcopilot.com/mcp/x/actions/readonly

# Model FQN the agent runs on: <PROVIDER_NAME>/<MODEL_NAME>. Must match a model a
# provider actually exposes (set MODEL_API_KEY here, or add the provider in the UI).
# claude-haiku-4-5 is the cheapest capable option — a full run is well under $1.
RELEASE_GUARDIAN_MODEL=anthropic/claude-haiku-4-5
# Second opinion for Gate 1 dual-model check (PRD §9.1).
RELEASE_GUARDIAN_MODEL_B=google-gemini/gemini-3-6-flash
