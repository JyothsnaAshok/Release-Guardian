# TrueForge server (local mode, no auth)
TRUEFORGE_BASE_URL=http://localhost:8790

# guardian-actions MCP server
# Binds to 127.0.0.1 by default — the endpoint is unauthenticated and its tools
# mutate approval/comms state, so keep it loopback-only unless it sits behind an
# authenticating proxy.
GUARDIAN_HOST=127.0.0.1
GUARDIAN_PORT=9100
GUARDIAN_DB_PATH=./data/guardian.sqlite
GUARDIAN_MCP_URL=http://localhost:9100/mcp

# --- Provider setup (scripts/setup-providers.mjs) ---
MODEL_PROVIDER=anthropic
MODEL_API_KEY=
MODEL_NAME=claude-sonnet-4-6
MODEL_UPSTREAM_ID=claude-sonnet-4-6
MODEL_CONTEXT_LENGTH=200000
MODEL_MAX_OUTPUT=64000
DAYTONA_API_KEY=

# Optional extra OpenAI-compatible "custom" provider (Cerebras). Used for the
# dual-model adversarial verification stretch (PRD §9.1).
CUSTOM_PROVIDER_NAME=cerebras
CUSTOM_BASE_URL=https://api.cerebras.ai/v1
# Check GET https://api.cerebras.ai/v1/models for the model ids your key can use.
CUSTOM_API_KEY=
CUSTOM_MODEL_NAME=gpt-oss-120b
CUSTOM_MODEL_UPSTREAM_ID=gpt-oss-120b
CUSTOM_MODEL_CONTEXT_LENGTH=131072
CUSTOM_MODEL_MAX_OUTPUT=32768

# Model FQN the agent runs on: <MODEL_PROVIDER>/<MODEL_NAME>.
# Must match a model that scripts/setup-providers.mjs actually provisions — with the
# defaults above that is the primary provider, i.e. anthropic/claude-sonnet-4-6.
# To run on a different provider (e.g. Google Gemini), add its provisioning to
# setup-providers.mjs and set the matching FQN here.
RELEASE_GUARDIAN_MODEL=anthropic/claude-sonnet-4-6
# Second opinion for Gate 1 dual-model check (PRD §9.1) — requires CUSTOM_API_KEY set
# so setup-providers.mjs provisions the custom provider.
RELEASE_GUARDIAN_MODEL_B=cerebras/gpt-oss-120b
